---
import { Icon } from 'astro-icon/components';

import { linkTo, siteLinks } from '../site-links.ts';

const ide = linkTo(siteLinks.ide);

const columns = [
  {
    links: [
      { href: linkTo(siteLinks.rulebook), label: 'Rulebook' },
      { href: linkTo(siteLinks.cliGuide), label: 'CLI guide' },
      { href: linkTo(siteLinks.androidManual), label: 'Android builder manual' },
    ],
    title: 'Read',
  },
  {
    links: [
      { href: ide, label: 'Browser IDE' },
      { href: linkTo(siteLinks.repository), label: 'Source' },
      { href: linkTo(siteLinks.releases), label: 'Releases' },
    ],
    title: 'Play',
  },
] as const;
---

{
  /* Closing CTA and footer share one dark band: after the arc there is one thing
    left to do, and repeating a whole section to say it would be padding. */
}
<footer class="border-t border-hairline bg-abyss">
  <div class="mx-auto max-w-[72rem] px-4 py-20 sm:px-6 sm:py-24">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal>
        <h2 class="display-sm text-[clamp(1.75rem,3.4vw,2.5rem)] text-ink">Send the first one down</h2>
        <p class="prose-copy mt-4">
          One android, one charger, and a board nobody has looked at. What it does next is whatever you and your agent
          taught it to do.
        </p>
        <div class="mt-7 flex flex-col gap-2.5 sm:flex-row">
          <a class="btn border-system/60 px-4 py-2.5 text-[0.9375rem] hover:border-system" href="#start">
            <Icon name="ph:terminal-window" class="size-4" aria-hidden="true" />
            Get the CLI
          </a>
          <a class="btn border-system/60 px-4 py-2.5 text-[0.9375rem] hover:border-system" href={ide}>
            <Icon name="ph:cursor-click" class="size-4" aria-hidden="true" />
            Open the IDE
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 lg:col-span-5">
        {
          columns.map((column) => (
            <nav aria-label={column.title}>
              <p class="label">{column.title}</p>
              <ul class="mt-3 flex flex-col gap-2">
                {column.links.map((link) => (
                  <li>
                    <a class="text-[0.9375rem] text-ink-dim hover:text-ink" href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-2 border-t border-hairline pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="flex items-center gap-2 text-[0.875rem] text-ink-faint">
        <span aria-hidden="true" class="text-system">◆</span>
        Project Nova
      </p>
      <p class="text-[0.875rem] text-ink-faint">
        Piece renders and the trailer are generated from the repository. Everything on this page is the game's own
        renderer.
      </p>
    </div>
  </div>
</footer>
