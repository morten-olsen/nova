---
import { Icon } from 'astro-icon/components';

import SiteFooter from '../components/site-footer.astro';
import SiteHeader from '../components/site-header.astro';
import BaseLayout from '../layouts/base.astro';
import { linkTo, siteLinks } from '../site-links.ts';

const ide = linkTo(siteLinks.ide);
---

<BaseLayout title="Project Nova: page not found" description="That page does not exist on the Project Nova site.">
  <SiteHeader />
  <main id="main" class="mx-auto flex min-h-[100dvh] max-w-[72rem] flex-col justify-center px-4 py-32 sm:px-6">
    <p class="readout text-sm text-system">404</p>
    <h1 class="display mt-4 text-[clamp(1.75rem,4vw,3rem)] text-ink">Nothing at this address</h1>
    <p class="prose-copy mt-4">
      The page you asked for does not exist. The board, the guide and the lab are all one level up.
    </p>
    <div class="mt-8 flex flex-col gap-2.5 sm:flex-row">
      <a class="btn border-system/60 px-4 py-2.5 text-[0.9375rem] hover:border-system" href={import.meta.env.BASE_URL}>
        <Icon name="ph:arrow-left" class="size-4" aria-hidden="true" />
        Back to the start
      </a>
      <a class="btn px-4 py-2.5 text-[0.9375rem]" href={ide}>
        <Icon name="ph:cursor-click" class="size-4" aria-hidden="true" />
        Open the IDE
      </a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
