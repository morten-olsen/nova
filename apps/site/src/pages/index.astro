---
import CampaignArc from '../components/campaign-arc.astro';
import FactoryQuickstart from '../components/factory-quickstart.astro';
import HeroBoard from '../components/hero-board.astro';
import PieceCatalogue from '../components/piece-catalogue.astro';
import Premise from '../components/premise.astro';
import SiteFooter from '../components/site-footer.astro';
import SiteHeader from '../components/site-header.astro';
import TrailerAct from '../components/trailer-act.astro';
import TwoWaysIn from '../components/two-ways-in.astro';
import BaseLayout from '../layouts/base.astro';
---

<BaseLayout
  title="Project Nova: program the androids that prepare a planet"
  description="A programming strategy game. Write the code your androids run, launch them into a simulated hostile world, and study what they actually did. Built for players who work with coding agents."
>
  <SiteHeader />
  {
    /*
    Story before doors. A visitor who scrolls past the hero should learn what
    the game is — a planet, a fleet on the way, and androids that only do what
    you programmed them to — before being asked to choose between a CLI and an
    IDE. The trailer follows immediately because it is the same premise shown
    rather than described, and only then does the page start explaining how to
    play. Both hero buttons still jump straight to #start for anyone who wants
    to skip the pitch entirely.
  */
  }
  <main id="main">
    <HeroBoard />
    <Premise />
    <TrailerAct />
    <TwoWaysIn />
    <FactoryQuickstart />
    <CampaignArc />
    <PieceCatalogue />
  </main>
  <SiteFooter />
</BaseLayout>
