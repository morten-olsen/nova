# `astro check` resolves @astrojs/check with a bare import from inside the astro
# package, which pnpm's strict layout does not allow: astro does not depend on
# it. Hoisting the one package into the root node_modules is what makes
# `pnpm --filter @morten-olsen/nova-site check` work.
#
# pnpm's own defaults for this setting cover eslint and prettier plugins, which
# have the same problem; those defaults are lost the moment this key is set, so
# they are repeated here.
public-hoist-pattern[]=@astrojs/check
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
