{
  "name": "@morten-olsen/nova-repo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "lint:eslint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc -b --pretty false && pnpm --filter @morten-olsen/nova-site check",
    "build": "pnpm run -r build",
    "test": "vitest run",
    "nova": "pnpm --filter @morten-olsen/nova-cli start",
    "dev:web": "pnpm --filter @morten-olsen/nova-web dev",
    "build:web": "pnpm --filter @morten-olsen/nova-web build",
    "trailer:scenarios": "pnpm --filter @morten-olsen/nova-trailer scenarios",
    "trailer:studio": "pnpm --filter @morten-olsen/nova-trailer studio",
    "trailer:render": "pnpm --filter @morten-olsen/nova-trailer render",
    "dev:ide": "pnpm --filter @morten-olsen/nova-ide dev",
    "build:ide": "pnpm --filter @morten-olsen/nova-ide build",
    "dev:site": "pnpm --filter @morten-olsen/nova-site dev",
    "build:site": "pnpm --filter @morten-olsen/nova-site build",
    "preview:site": "pnpm --filter @morten-olsen/nova-site preview"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9",
    "@pnpm/find-workspace-packages": "^6.0.9",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.3"
  }
}
