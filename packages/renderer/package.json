{
  "name": "@morten-olsen/nova-renderer",
  "version": "1.0.0",
  "type": "module",
  "description": "Shared tabletop renderer and 3D assets for Project Nova",
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "check": "tsc -b --pretty false",
    "build": "tsc -b --pretty false"
  },
  "exports": {
    ".": {
