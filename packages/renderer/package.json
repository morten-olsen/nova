      "types": "./dist/nova-renderer.d.ts",
      "import": "./dist/nova-renderer.js",
      "default": "./dist/nova-renderer.js"
    }
  },
  "dependencies": {
    "@morten-olsen/nova-game": "workspace:*",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@morten-olsen/nova-config": "workspace:*",
    "@types/three": "^0.183.0",
    "typescript": "^5.9.2"
  }
}
