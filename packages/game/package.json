{
  "name": "@morten-olsen/nova-game",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "check": "tsc -b --pretty false",
    "build": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "source": "./src/nova-game.ts",
      "types": "./dist/nova-game.d.ts",
      "import": "./dist/nova-game.js",
      "default": "./dist/nova-game.js"
    },
    "./browser": {
      "source": "./src/nova-game.browser.ts",
      "types": "./dist/nova-game.browser.d.ts",
      "import": "./dist/nova-game.browser.js",
      "default": "./dist/nova-game.browser.js"
    }
  },
  "devDependencies": {
    "@morten-olsen/nova-config": "workspace:*",
    "@morten-olsen/nova-tests": "workspace:*",
    "@types/node": "^24.0.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
